# Copy this file to .env and fill in your real Supabase connection string.
# Supabase dashboard → Project Settings → Database → Connection string → "URI"
# Use the "Connection pooling" URI (port 6543) if you deploy to a serverless
# host; the direct one (port 5432) is fine for Render/DuckDNS/local.
DATABASE_URL=postgresql://postgres:YOUR-PASSWORD@db.YOUR-PROJECT-REF.supabase.co:5432/postgres

PORT=3000
